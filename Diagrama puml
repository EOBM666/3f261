@startuml

class Mover {
  + mover()
}

class Comer {
  + comer()
}

class Calcular {
  + calcular()
}

class Renderizar {
  + dibujar()
}

class Reproducir {
  + reproducir()
  + detener()
}

class Colisionar {
  + verificar()
}

class ObjetoJuego

class Posicion

class PersonajePacman {
  - vidas
}
ObjetoJuego --|> PersonajePacman
PersonajePacman --|> Comer
PersonajePacman --|> Mover

class BocaPacman {
  + abrir()
  + cerrar()
}
PersonajePacman *-- BocaPacman

class Animacion
Animacion --|> Reproducir
PersonajePacman *-- Animacion

class Fantasma {
  + perseguir()
  + huir()
}
ObjetoJuego --|> Fantasma
Fantasma *-- Posicion
Fantasma --|> Calcular

class Blinky
Fantasma --|> Blinky

class Pinky
Fantasma --|> Pinky

class Inky
Fantasma --|> Inky

class Clyde
Fantasma --|> Clyde

class Fruta {
  + aparecer()
  + desaparecer()
}
ObjetoJuego --|> Fruta

class Punto {
  + recoger()
}
ObjetoJuego --|> Punto

class PuntoEspecial {
  + activarModo()
}
Punto --|> PuntoEspecial

class Celda {
  + estaLibre()
}

class CeldaLibre
Celda --|> CeldaLibre
CeldaLibre *-- Punto

class Pared
Celda --|> Pared

class Tablero {
  + cargar()
}
Tablero *-- Celda
Tablero *-- Posicion
Tablero o-- Fruta

class ColisionDetector
ColisionDetector --|> Colisionar
ColisionDetector *-- Tablero

class GestorVidas {
  + perder()
  + quedan()
}

class GestorNivel {
  + siguiente()
  + velocidad()
}
GestorNivel *-- Tablero

class GestorPuntuacion {
  + agregar()
  + reiniciar()
}

class EstadoJuego {
  + cambiar()
}

class Marcador {
  + mostrar()
}

class ManejadorEntrada {
  + leerTecla()
}

class Temporizador {
  + tick()
}

class Sonido
Sonido --|> Reproducir

class Configuracion {
  + cargarNivel()
}

class Renderizador
Renderizador --|> Renderizar
Renderizador *-- Tablero
Renderizador *-- PersonajePacman

class Pacman {
  + iniciar()
  + actualizar()
  + pausar()
}
Pacman *-- PersonajePacman
Pacman *-- Tablero
Pacman *-- GestorVidas
Pacman *-- GestorNivel
Pacman *-- GestorPuntuacion
Pacman *-- EstadoJuego
Pacman *-- Marcador
Pacman *-- Blinky
Pacman *-- Pinky
Pacman *-- Inky
Pacman *-- Clyde
Pacman o-- Fruta
Pacman *-- ColisionDetector
Pacman *-- Renderizador
Pacman *-- ManejadorEntrada
Pacman *-- Temporizador
Pacman *-- Sonido
Pacman *-- Configuracion

@enduml
